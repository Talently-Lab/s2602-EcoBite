PORT=3000
DATABASE_URL="postgresql://ecobite:ecobite@localhost:5432/ecobite?schema=public"
# Opcional: conexion directa para migraciones (Neon sin "-pooler" en el host).
# DATABASE_URL sigue siendo la conexion del runtime y del seed.
DIRECT_URL=

# Generar un secreto aleatorio de al menos 32 bytes; no usar este placeholder.
JWT_SECRET=
# Orígenes del frontend separados por comas. Sin rutas ni comodines.
CORS_ORIGINS=http://localhost:5173
# Solo usar 1 detras de un proxy controlado (Render); en local, 0.
TRUST_PROXY_HOPS=0

# Opcional: el seed crea o promueve la cuenta administradora.
# Email y contraseña deben configurarse juntos; si ambos faltan, el seed
# no toca usuarios. En cada ejecución reemplaza contraseña, rol y estado.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Opcional: nombre visible cuando el seed crea la cuenta.
SEED_ADMIN_NAME=

# Opcional: si se define, el seed crea las cuentas demo del PM con esta
# contraseña (mínimo 8 caracteres): cliente.demo@ecobite.test (CLIENTE) y
# restaurante.demo@ecobite.test (RESTAURANTE_ADMIN + restaurante aprobado e
# inactivo, nunca visible en el catálogo público).
SEED_DEMO_USERS_PASSWORD=

# Opcional: envio de correos transaccionales (aprobacion de solicitud de
# restaurante). Proveedor: Brevo (api.brevo.com). Ambas variables deben
# configurarse juntas; sin ellas los correos solo se registran en el log.
# EMAIL_FROM debe ser un remitente verificado en la cuenta de Brevo.
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=EcoBite
