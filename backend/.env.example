PORT=3000
DATABASE_URL="postgresql://ecobite:ecobite@localhost:5432/ecobite?schema=public"
# Opcional: conexion directa para migraciones (Neon sin "-pooler" en el host).
# DATABASE_URL sigue siendo la conexion del runtime y del seed.
DIRECT_URL=

# Generar un secreto aleatorio de al menos 32 bytes; no usar este placeholder.
JWT_SECRET=
# Orígenes del frontend separados por comas. Sin rutas ni comodines.
CORS_ORIGINS=http://localhost:5173
# Solo usar 1 detras de un proxy controlado (Render); en local, 0.
TRUST_PROXY_HOPS=0
